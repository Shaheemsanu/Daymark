# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Firebase web configuration (public client-side values)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_VAPID_KEY=your-public-web-push-key

# Base URL path (default: / or /repository-name/ for GitHub Pages)
VITE_BASE_PATH=/

# Daymark AI (server-side secrets; existing variable names retained)
GEMINI_GENERAL_API_KEY=your-gemini-api-key
GEMINI_GENERAL_MODEL=gemini-3.5-flash-lite
